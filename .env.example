# Every value here is optional unless marked required — defaults live in
# config/index.js and match the values shown. Copy to .env.local and edit.

# ── Supabase (required) ───────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_ENV_TABLE=environment
SUPABASE_FOCUS_TABLE=focus
SUPABASE_TIMEOUT_MS=10000

# ── AI providers (see docs/06-ai-providers.md) ────────────
# Tried in order until one answers; if all fail the local rule engine replies.
# AI_PROVIDER_ORDER=local,gemini

# Self-hosted OpenAI-compatible endpoint (llama-swap, llama.cpp, LM Studio,
# Ollama…) — the first engine tried. AI_LOCAL_MODEL defaults to gemma4:e2b, the
# model this deployment runs; set it to empty to auto-pick whichever model the
# endpoint reports as loaded instead.
# AI_LOCAL_BASE_URL=http://kagenou.serveminecraft.net:2000
# AI_LOCAL_MODEL=gemma4:e2b
# AI_LOCAL_API_KEY=
# Reasoning models burn their whole token budget on thinking and return empty
# content — keep this off unless you raise AI_LOCAL_MAX_TOKENS a lot.
# AI_LOCAL_THINKING=false
# AI_LOCAL_TIMEOUT_MS=120000
# AI_LOCAL_MAX_TOKENS=2048

# Google AI Studio (optional — leave the key empty to skip this provider)
GEMINI_API_KEY=
# Same as the app's built-in default, so this line only matters if you change it.
# Pinning a model here outranks that default, and Google retires model names for
# new keys while its own list endpoint still advertises them — a deployment that
# pinned gemini-2.5-flash kept answering 404 long after everything else looked
# configured. Leave it blank to follow the app default, or to let the app ask the
# API which models the key can actually call.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_OUTPUT_TOKENS=1024
# How hard the model thinks when the brain button is on: minimal|low|medium|high.
# Flash-Lite thinks `minimal` unless told otherwise, which shows no thoughts at all.
# GEMINI_THINKING_LEVEL=medium
# Thoughts are counted as output tokens, so a thinking turn needs its own ceiling.
# GEMINI_THINKING_MAX_OUTPUT_TOKENS=4096
# AI_MAX_HISTORY_TURNS=10

# Relay: set on a machine that cannot reach the providers itself (venue Wi-Fi,
# raw-IP demo box). Its AI routes then forward to this deployment instead.
# AI_RELAY_URL=https://enviroment-monitor.vercel.app
# AI_RELAY_TIMEOUT_MS=130000

# Let the browser's Dev Settings override endpoints/keys/models via x-ai-*
# headers. Convenient for demos; turn off on anything public.
# AI_ALLOW_CLIENT_OVERRIDES=true
# AI_MODEL_CACHE_MS=60000

# ── Assistant tools ───────────────────────────────────────
# The chat assistant is given tools (sensors, history, health risks, camera
# focus, sensor/behaviour correlation, web search) instead of a prompt with
# data pasted into it. Turning this off leaves it with no way to read anything.
# AI_TOOLS_ENABLED=true
# AI_TOOLS_MAX_ROUNDS=4
# AI_TOOLS_MAX_CALLS=8

# Which providers may hold camera/focus data. Anything not listed here is never
# offered the focus tool, is told in its system prompt that it cannot reach that
# data, and is refused if it calls the tool anyway. Adding a cloud provider here
# sends camera-derived data off the network — that is the whole decision.
# `browser` is the WebGPU engine inside the user's own browser: it sends nothing
# anywhere, and the Focus tab already fetches those rows into that same browser.
# AI_FOCUS_PROVIDERS=local,browser

# Web search (Tavily), reachable only when the user turns the search button on.
# Without a key the tool is never offered, so the model cannot promise a search.
# TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com
# TAVILY_MAX_RESULTS=5
# TAVILY_DEPTH=basic
# TAVILY_TIMEOUT_MS=15000

# ── On-device AI in the browser (WebGPU) ─────────────────
# The assistant can run the model in the user's own browser on their GPU
# (@mlc-ai/web-llm), instead of calling a provider. Weights come from the MLC CDN
# straight to the browser; the server only assembles the snapshot prompt, because
# a 4-bit model of that size cannot be trusted to call tools.
# AI_BROWSER_ENABLED=true
# Rows of camera history folded into that prompt. Far fewer than the summary's:
# the whole context window is 4096 tokens, shared with the answer.
# AI_BROWSER_FOCUS_ROWS=60

# ── Streaming chat ────────────────────────────────────────
# Off means the assistant falls back to the non-streaming /api/chat.
# AI_STREAM_ENABLED=true
# Wall clock for one streamed turn, tool rounds included.
# AI_STREAM_BUDGET_MS=120000

# ── API behaviour ─────────────────────────────────────────
API_DEFAULT_HOURS=24
API_MAX_HOURS=168
API_DEFAULT_HISTORY_LIMIT=200
API_MAX_HISTORY_LIMIT=1000
API_DEVICE_SCAN_LIMIT=1000
# API_DEVICE_LOOKBACK_HOURS=168
# API_FALLBACK_ROWS=40

# ── Client defaults (served via /api/config) ─────────────
CLIENT_POLL_MS_DEFAULT=5000
CLIENT_POLL_MS_MIN=3000
# CLIENT_POLL_MS_MAX=60000
# CLIENT_HEALTH_POLL_MS=30000
# CLIENT_FLOOD_REFRESH_MS=60000
# CLIENT_GOV_REFRESH_MS=300000

# ── Focus (webcam) feed ───────────────────────────────────
FOCUS_FETCH_LIMIT=120
FOCUS_POLL_MS=20000
FOCUS_REALTIME_RETRY_MS=15000
FOCUS_THRESHOLD_DEFAULT=8
# FOCUS_REALTIME_HEARTBEAT_MS=25000
# FOCUS_BUCKET_MS=60000
# FOCUS_CHART_BUCKETS=30

# pi-vision — ค่าตั้งทั้งหมด
# คัดลอกเป็น .env แล้วแก้เฉพาะบรรทัดที่ต้องการ
# ทุกค่าเป็น optional — ค่า default อยู่ใน config.py และตรงกับที่เขียนไว้ตรงนี้

# ── กล้อง ────────────────────────────────────────────────
# csi = Camera Module 3 (Picamera2) · usb = USB webcam (OpenCV) · auto = ลอง csi ก่อน
CAMERA_SOURCE=auto
# ถามกล้องว่ารองรับโหมดอะไรบ้าง แล้วเลือกขนาดให้เอง (ตอนนี้ถามได้เฉพาะ Windows)
# เกณฑ์: สัดส่วนกว้างสุดที่กล้องมี → ทำได้ถึง CAMERA_FPS → ใหญ่สุดที่เหลือ
# ถามไม่ได้เมื่อไร ถอยไปใช้ CAMERA_WIDTH/HEIGHT ข้างล่างเหมือนเดิม
# ดูรายการโหมด: python -c "import camera; print(camera.capture_modes(0))"
CAMERA_AUTO_SIZE=true
# เพดานความกว้างตอนเลือกเอง — กันไม่ให้คว้าโหมดใหญ่จน CPU ตามไม่ทัน
CAMERA_AUTO_MAX_WIDTH=1280
# ใช้เมื่อ CAMERA_AUTO_SIZE=false หรือถามโหมดจากกล้องไม่ได้
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# เป็นทั้งความเร็วที่ลูปเดิน และ**เกณฑ์คัดโหมด**ตอน CAMERA_AUTO_SIZE=true
# ขอสูงขึ้น = ได้ภาพเล็กลง (วัดกับ C922: 10→1280x720 · 15→1024x576 · 20→864x480)
CAMERA_FPS=15
# index ของ USB webcam (0 = ตัวแรก) หรือใส่ path เช่น /dev/video0
CAMERA_USB_INDEX=0
# เลือกกล้องด้วยชื่อรุ่นแทน index — ใส่แค่บางส่วนของชื่อ ไม่สนตัวพิมพ์เล็ก-ใหญ่
# ตั้งค่านี้แล้ว CAMERA_USB_INDEX ไม่มีผล · index สลับเองเวลาถอด-เสียบ ชื่อรุ่นไม่สลับ
# ดูรายชื่อที่เครื่องเห็น: python -c "import camera; print(camera.capture_devices())"
# CAMERA_USB_NAME=c922
# backend ของ OpenCV: auto / dshow / msmf / v4l2 / any
# ⚠️ Windows: auto = dshow · อย่าตั้งเป็น any หรือ msmf เว้นแต่รู้ว่าทำไม
#    เว็บแคม USB หลายรุ่น (เช่น C922) ไม่โผล่ใน Media Foundation เลย = เปิดไม่ได้
#    และกล้องในตัวโน้ตบุ๊กบางรุ่นใช้เวลาเปิดผ่านทางนั้นเป็นนาที
CAMERA_API=auto
# รหัสภาพที่ขอจากกล้อง (เช่น MJPG) — ว่าง = ใช้ค่าที่กล้องให้มาเอง
# ไม่ใช่ปุ่มเร่งความเร็ว: กล้อง/ไดรเวอร์มีสิทธิ์ไม่ทำตาม (วัดกับ C922 บน Windows แล้ว
# ที่ 1280x720 ตั้ง MJPG หรือไม่ตั้งก็ได้ 10fps เท่ากัน — ไดรเวอร์ไม่ยอมเปลี่ยนโหมด)
# ที่ 640x480 ไม่ต้องตั้ง ได้ตามที่ขอครบอยู่แล้ว · การตั้งทำให้เปิดกล้องช้าลง ~1 วินาที
# ลองแล้ววัดผลก่อนค่อยเก็บไว้ อย่าตั้งเพราะคิดว่าน่าจะช่วย
# CAMERA_FOURCC=MJPG
# ถามว่าจะใช้กล้องตัวไหนตอนเปิดโปรแกรม — ถามเฉพาะเมื่อมีหน้าจอและเจอกล้องเกินหนึ่งตัว
# false = ใช้ค่าข้างบนเลยไม่ต้องถาม (ควรตั้งเป็น false เมื่อรันผ่าน systemd)
CAMERA_ASK=true
# พลิกซ้าย-ขวาให้เหมือนส่องกระจก
# ⚠️ ค่านี้กำหนดว่าป้าย Left/Right หมายถึงด้านไหน — ถ้าเปลี่ยนต้องดูผลบนจอซ้ำ
CAMERA_MIRROR=true
# หมุนภาพ 0 / 90 / 180 / 270 เผื่อติดกล้องตะแคง
CAMERA_ROTATE=0
# ── ชัตเตอร์ — ตัวคุมภาพเบลอตอนคนขยับ ──────────────────
# ว่าง = ให้กล้องปรับเอง (เหมาะกับแสงที่เปลี่ยนไปมา แต่แสงน้อยเมื่อไรมันจะยืดชัตเตอร์
# ให้ยาวขึ้น ซึ่งคือที่มาของภาพเบลอ) · ตัวเลขติดลบ = 2^N วินาที (-7 = 1/128s)
# ⚠️ แก้ที่ต้นเหตุที่สุดของอาการ "ขยับแล้วหน้าหลุด" เพราะการเบลอเกิดที่เซนเซอร์
#    ซอฟต์แวร์กู้คืนไม่ได้ · วัดแล้ว: FaceLandmarker ทนเบลอได้ราว 25-30% ของความ
#    กว้างใบหน้า ส่วนตัวตรวจจับทนได้มากกว่านั้นมาก (ตัว landmarker คือคอขวด)
# ต้องหาค่าที่เหมาะกับแสงห้องคุณเอง แล้วใส่ gain ชดเชยความสว่างที่หายไป
# CAMERA_EXPOSURE=-7
# CAMERA_GAIN=255

# ── โมเดล MediaPipe ──────────────────────────────────────
# ไฟล์จะถูกดาวน์โหลดอัตโนมัติครั้งแรกถ้ายังไม่มี
MODEL_PATH=models/face_landmarker.task
# MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
MODEL_AUTO_DOWNLOAD=true
# จำนวนใบหน้าสูงสุดที่วิเคราะห์พร้อมกัน — ดูตาราง CPU ใน README ก่อนเพิ่ม
MODEL_MAX_FACES=6
MODEL_MIN_DETECTION_CONFIDENCE=0.5
MODEL_MIN_PRESENCE_CONFIDENCE=0.5
MODEL_MIN_TRACKING_CONFIDENCE=0.5
# blendshapes ให้คะแนนการหลับตาที่แม่นกว่า EAR มาก — ควรเปิดไว้
MODEL_BLENDSHAPES=true
# transformation matrix ให้มุมหันหน้าเป็นองศาจริง — เปิดเมื่อใช้ POSE_METHOD=matrix
MODEL_TRANSFORM_MATRIX=false

# ── เห็นคนที่อยู่ไกล (โหมดติดตามกิจกรรมเท่านั้น) ─────────
# ตัวตรวจใบหน้า full-range + การซูมเข้าที่ใบหน้าก่อนอ่าน landmark
# ⚠️ สองอย่างนี้แยกกันไม่ได้ — ตัวตรวจให้แค่ "กรอบ" ไม่มี landmark จึงยังไม่มีชื่อ
#    ไม่มีค่าจากดวงตา ไม่มีอารมณ์ · การซูมคือสิ่งที่เปลี่ยนกรอบนั้นให้เป็นข้อมูล
#
# วัดจากภาพจริง: landmarker จากภาพเต็มหมดแรงที่ใบหน้าราว 80 px (~1.5 m)
# ตัวตรวจ full-range ยังเห็นถึงราว 40 px (~3 m) และการซูมกู้ landmark กลับมาได้
DETECT_MODEL_PATH=models/blaze_face_full_range.tflite
DETECT_AUTO_DOWNLOAD=true
# โมเดล full-range มองพื้นที่กว้างกว่า จึงมีโอกาสเห็นลายบนผนังเป็นหน้าคนมากกว่า
# เจอกรอบผีขึ้นมา ให้เพิ่มค่านี้ก่อนเป็นอย่างแรก
DETECT_MIN_CONFIDENCE=0.5
DETECT_MIN_SUPPRESSION=0.3
# IoU ที่ถือว่ากรอบจากตัวตรวจกับใบหน้าที่ landmarker เห็นแล้ว เป็นคนเดียวกัน
# (ใบหน้าที่ landmarker เห็นอยู่แล้วไม่ต้องซูมซ้ำ)
DETECT_MERGE_IOU=0.3
#
# ⚠️ ตัวคุมราคาหลักของการซูม: ซูมได้กี่ใบหน้าต่อเฟรม · 0 = ปิดการซูมทั้งหมด
# แต่ละครั้งคือ inference ของ FaceLandmarker หนึ่งรอบ · คนที่เกินโควตาไม่ได้ถูกทิ้ง
# แค่รอคิวเฟรมถัดไป และคนที่รอนานสุดได้ก่อนเสมอ
ROI_MAX_PER_FRAME=2
# ส่วนเผื่อรอบใบหน้าก่อนครอป — ครอปชิดเกินไปแล้วโมเดลจะหาหน้าไม่เจอในภาพครอปเสียเอง
ROI_MARGIN=0.6
# ขยายภาพครอปให้ด้านสั้นไม่ต่ำกว่านี้ก่อนป้อนโมเดล — นี่คือหัวใจของฟีเจอร์
ROI_MIN_PX=256
ROI_MAX_PX=512
# เกลี่ยกรอบครอปกับเฟรมก่อน — กันภาพซูมกระตุกและกัน landmark สั่น
ROI_SMOOTHING=0.6

# ── ท่าทางร่างกาย (โหมดติดตามกิจกรรมเท่านั้น) ────────────
# ⚠️ คนละเรื่องกับหมวด "การหันหน้า" ข้างล่าง — หมวดนี้คือ**ท่าทางตัว** (ยกมือ โบกมือ
#    กอดอก เท้าเอว ชี้ ยืน/นั่ง) อ่านจาก MediaPipe Pose 33 จุด · โมเดลคนละตัวกัน
#    โหมด room/person/known ไม่โหลดโมเดลนี้เลย จึงไม่จ่ายอะไรทั้งสิ้น
#
# lite 5.8 MB · full 9.4 MB และช้ากว่า — บน Pi ใช้ lite
BODY_MODEL_PATH=models/pose_landmarker_lite.task
BODY_AUTO_DOWNLOAD=true
# กี่คนพร้อมกัน
BODY_MAX_PEOPLE=3
# ⚠️ ตัวคุมราคาที่สำคัญที่สุด — ตรวจท่าทางทุกกี่เฟรม
# ท่าทางเปลี่ยนในระดับหลายร้อยมิลลิวินาที ไม่ใช่ระดับเฟรม การตรวจทุกเฟรมคือการจ่าย
# CPU ให้ข้อมูลที่ไม่มีใครใช้ · 4 = ราว 4 ครั้ง/วินาทีที่ 15 fps ซึ่งเกินพอสำหรับท่าทาง
# ถ้าบน Pi แล้ว fps ตก ให้เพิ่มค่านี้ก่อนเป็นอย่างแรก แล้วค่อยลด BODY_MAX_PEOPLE
BODY_EVERY_N_FRAMES=4
BODY_MIN_DETECTION_CONFIDENCE=0.5
BODY_MIN_PRESENCE_CONFIDENCE=0.5
BODY_MIN_TRACKING_CONFIDENCE=0.5
# จุดที่ visibility ต่ำกว่านี้ถือว่ามองไม่เห็น
# ⚠️ MediaPipe **เดาตำแหน่งจุดที่ถูกบังให้เสมอ** และค่าที่ได้หน้าตาเหมือนข้อมูลจริง
#    ทุกอย่าง ต่างกันแค่ visibility · ถ้าตั้งต่ำเกินไป ขาที่อยู่ใต้โต๊ะจะทำให้ระบบ
#    ตอบว่า "ยืน" อย่างมั่นใจ · ตั้งสูงเกินไป คนที่ยืนครึ่งตัวในเฟรมจะไม่ถูกอ่านเลย
BODY_MIN_VISIBILITY=0.6
#
# ── เกณฑ์ของแต่ละท่า — เป็น**สัดส่วนของความกว้างไหล่** ไม่ใช่พิกเซล ──
# ท่าเดียวกันจึงให้คำตอบเดียวกันไม่ว่าคนจะยืนใกล้หรือไกลกล้อง
# ข้อมือต้องสูงกว่าไหล่เท่านี้ถึงนับว่ายกมือ (กันมือที่พาดอยู่ระดับไหล่พอดี)
BODY_WRIST_ABOVE_SHOULDER=0.10
# ไหล่→ข้อมือ ต้องยาวอย่างน้อยเท่านี้เท่าของ (ต้นแขน+ปลายแขน) ถึงนับว่าเหยียดตรง = ชี้
BODY_STRAIGHT_RATIO=0.90
BODY_POINT_REACH=0.25
BODY_HAND_NEAR_HIP=0.35
BODY_CROSS_OVERLAP=0.10
# ── ยืน / นั่ง / นอน — วัดเป็น**องศาจริง** จาก landmark สามแกน ──
# ใช้ pose_world_landmarks (หน่วยเมตร) ที่โมเดลคืนมาพร้อมพิกัดบนภาพอยู่แล้ว
# ไม่มีต้นทุนเพิ่ม และไม่ต้องตั้งค่าคงที่ที่อธิบายที่มาไม่ได้อีก
#
# ⚠️ เหตุผลที่ต้องใช้สามแกน: ต้นขาที่ชี้เข้าหาเลนส์**หดสั้นบนภาพ** · วัดจริงกับรูปหนึ่งใบ
#    ต้นขาที่ทำมุม 34° กับแนวดิ่ง เหลือเพียง 7° เมื่อดูจากพิกัดสองแกน — คลาดไป 27°
#    และคลาดไปในทางที่ทำให้ท่านั่งหน้าตาเหมือนท่ายืนพอดี
#
# มุมของต้นขาเทียบแนวดิ่ง · ต่ำกว่าค่าแรก = ยืน · สูงกว่าค่าที่สอง = นั่ง
# อยู่ระหว่างสองค่า = กำลังลุก/กำลังนั่งลง → ตอบข้างที่ใกล้กว่าแล้วติด ? ไว้
BODY_STAND_ANGLE_DEG=30
BODY_SIT_ANGLE_DEG=60
# ลำตัวเอียงจากแนวดิ่งเกินเท่านี้ = นอน · ถ้าขายังตั้งอยู่จะนับเป็น "ยืนก้มตัว" แทน
# "นอน" ใช้แค่ไหล่กับสะโพก จึงตอบได้แม้ขาอยู่นอกเฟรม (ต่างจากยืน/นั่ง)
BODY_LYING_ANGLE_DEG=55
# ── เมื่อมองไม่เห็นขา ──
# ระบบ**ตอบเสมอ** ไม่มีคำว่า "ไม่รู้" เพราะคนต้องอยู่ในท่าใดท่าหนึ่ง — แต่จะบอกด้วยว่า
# คำตอบนั้นวัดได้จริงหรือเดา · ท่าที่เดามี `?` ต่อท้ายบนหน้าจอ (เช่น sitting?)
# ⚠️ อย่าเอาไปนับสถิติโดยไม่แยกสองอย่างนี้ออกจากกัน
#
# สะโพกอยู่ต่ำกว่าค่านี้ในเฟรม (0–1) = ตัวถูกขอบล่างตัด → คงท่าเดิมไว้
# สูงกว่านี้แต่ขาหายไป = มีโต๊ะหรือของบังอยู่ → เดาว่านั่ง
BODY_FRAME_EDGE=0.90
# ── ยืน/นั่ง จากความสูงศีรษะ เมื่อมองไม่เห็นขา ──────────
# กล้องบนโต๊ะแทบไม่เคยเห็นขา ท่าที่ได้จึงเป็นการเดาจากหลักฐานอ้อมแทบทุกครั้ง
# เปิดค่านี้แล้วระบบจะ**จดความสูงศีรษะตอนที่วัดขาได้จริง**ไว้ แล้วเอามาเทียบตอนขาหาย
# ตอบผิดแบบที่หายไป: ลุกยืนหลังโต๊ะแล้วยังขึ้นว่า "นั่ง" อย่างมั่นใจ
BODY_HEAD_POSTURE=true
# ลุกจากเก้าอี้แล้วศีรษะสูงขึ้นกี่เท่าของความกว้างไหล่
# 1.0 มาจากสัดส่วนร่างกายจริง (ตานั่ง ~123 ซม. · ตายืน ~163 ซม. · ไหล่กว้าง ~36–40 ซม.)
# ค่านี้ไม่ขึ้นกับระยะห่างจากกล้องเลย เพราะทั้งความสูงและความกว้างไหล่บนภาพ
# ย่อ-ขยายตามระยะพร้อมกัน หารกันแล้วตัดทิ้งหมด
BODY_HEAD_RISE=1.0
# ความสูงของสองท่าที่จดไว้ต้องห่างกันเกินนี้ ถึงจะเชื่อว่าเป็นคนละท่าจริง
BODY_HEAD_MIN_GAP=0.5
# ถ่วงค่าที่จดไว้กับค่าใหม่ — สูง = จำของเดิมแน่น ปรับตัวช้า
BODY_HEAD_SMOOTHING=0.8
# ต้องเห็นท่าใหม่ค้างกี่วินาทีถึงจะเปลี่ยน — คนไม่ได้สลับยืนกับนั่งวินาทีละครั้ง
# ตั้งต่ำเกินไปแล้วป้ายจะกระพริบตอน landmark สั่น ซึ่งดูเหมือนระบบอ่านผิดทั้งที่ไม่ผิด
BODY_POSTURE_HOLD_SECONDS=1.0
# ท่าที่**เดา** ต้องค้างนานกว่านี้เท่าตัวถึงจะเปลี่ยนได้ — หลักฐานอ้อม ๆ แกว่งง่ายกว่า
# การวัดจริงมาก ถ้าให้เวลาเท่ากัน คนที่นั่งอยู่จะถูกสลับเป็นยืนทุกครั้งที่ขาโผล่มาแวบหนึ่ง
BODY_POSTURE_UNSURE_MULTIPLIER=2.5
#
# ── การถือค้างและการโบกมือ ──
# ต้องเห็นท่าเดิมค้างกี่วินาทีถึงประกาศ (กันป้ายกระพริบตอน landmark สั่น)
BODY_HOLD_SECONDS=0.4
# ต้องหายไปนานกว่านี้ถึงเลิกแสดงป้าย — สั้นกว่านี้ป้ายจะกระพริบตอน landmark หลุด
BODY_RELEASE_SECONDS=0.7
# ยกมือแล้วข้อมือแกว่งกลับทิศครบตามนี้ในหน้าต่างเวลานี้ = โบกมือ (ไม่ใช่แค่ยกค้าง)
BODY_WAVE_SECONDS=1.5
BODY_WAVE_REVERSALS=2
BODY_WAVE_MIN_SWING=0.15

# ── ใช้โทรศัพท์อยู่หรือเปล่า ───────────────────────────────
# ใช้เฉพาะโหมดติดตามกิจกรรม และ**ต้องมีโมเดลท่าทางเปิดอยู่ด้วย** เพราะการบอกว่า
# "ใครถือ" ต้องรู้ตำแหน่งข้อมือ · ปิดตัวนี้ถ้า CPU ไม่พอ (ดู README หัวข้อ "ราคาที่ต้องจ่าย")
#
# ⚠️ ต้องเพิ่มคอลัมน์ phone / phone_confident ในตาราง focus ก่อนใช้งานจริง
#    ไม่งั้น PostgREST ตอบ 400 แล้วข้อมูลกล้อง**ทั้งหมด**จะถูกทิ้ง ไม่ใช่แค่คอลัมน์นี้
#    (SQL อยู่ใน README หัวข้อ "ต่อกับแดชบอร์ด")
PHONE_ENABLED=true
# โมเดล COCO 90 คลาส — โปรแกรมกรองเหลือคลาสเดียวคือ cell phone ตั้งแต่ในตัวโมเดล
# lite0 = 13 MB · input 320px (ค่าเริ่มต้น) · lite2 = ใหญ่กว่า input 448px เห็นของเล็กกว่า
PHONE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/object_detector/efficientdet_lite0/float32/1/efficientdet_lite0.tflite
PHONE_AUTO_DOWNLOAD=true
# ⚠️ ตัวคุมราคาหลัก · ถูกปัดขึ้นเป็นจำนวนเท่าของ BODY_EVERY_N_FRAMES เสมอ
# เพราะการจับคู่ต้องใช้ข้อมือของเฟรมเดียวกัน ไม่ใช่ของเมื่อสี่เฟรมก่อน
PHONE_EVERY_N_FRAMES=8
# ตั้งสูงกว่าตัวตรวจใบหน้า เพราะของสี่เหลี่ยมมืด ๆ ในห้อง (รีโมท กระเป๋าดินสอ ขอบโน้ตบุ๊ก)
# หน้าตาเหมือนโทรศัพท์มาก — วัดกับรูปจริงแล้วเจอของบนโต๊ะได้คะแนน 0.40 พอดี
PHONE_MIN_SCORE=0.4
PHONE_MAX_RESULTS=10
# ── โทรศัพท์ทุกเครื่องที่เห็นต้องมีเจ้าของไหม ──
# true  = ยกให้คนที่อยู่ใกล้ที่สุดเสมอ แม้ไม่มีหลักฐานว่าถืออยู่
# false = โหมดเข้ม ไม่มีหลักฐานก็ไม่นับให้ใคร
# ⚠️ true แปลว่า**โทรศัพท์ที่วางบนโต๊ะก็ถูกนับว่ามีคนใช้** (คนที่นั่งใกล้มันที่สุด)
#    ถ้าต้องการเฉพาะที่เห็นอยู่ในมือจริง ให้กรองด้วยคอลัมน์ phone_confident=true
#    ที่ปลายทาง หรือตั้งค่านี้เป็น false
PHONE_NEAREST_ALWAYS=true
# ระยะจากข้อมือที่ยังถือว่า "อยู่ในมือ" — สัดส่วนของความกว้างไหล่ ไม่ใช่พิกเซล
# นี่คือชั้นเดียวที่ทำให้ phone_confident เป็น true
PHONE_HAND_REACH=0.6
# "ช่องใต้ใบหน้า" — ท่าที่คนถือโทรศัพท์อยู่จริง · ใช้จัดลำดับว่าใครน่าจะเป็นเจ้าของกว่ากัน
# เมื่อไม่มีใครเห็นข้อมือ (คนที่โทรศัพท์อยู่ใต้หน้าพอดี ชนะคนที่บังเอิญนั่งใกล้กว่า)
# สัดส่วนของความกว้างใบหน้า · แยกสองแกนเพราะมือคนอยู่ในแนวดิ่งใต้หัว ไม่ใช่เฉียงออกข้าง
PHONE_FACE_SIDE=0.75
PHONE_FACE_BELOW=2.5
# กันป้ายกระพริบ — release ยาวกว่า hold เพราะตัวตรวจวัตถุหลุดเป็นเฟรม ๆ เป็นเรื่องปกติ
PHONE_HOLD_SECONDS=0.6
PHONE_RELEASE_SECONDS=2.0

# ── การหันหน้า ───────────────────────────────────────────
# geometric = ประมาณจากตำแหน่งจมูก (ค่าเริ่มต้น ผ่านการทดสอบแล้ว)
# matrix    = จาก transformation matrix ได้องศาจริง แม่นกว่าเมื่อหันมาก
#             ต้องเปิด MODEL_TRANSFORM_MATRIX และยืนยันทิศบนจอก่อน
# auto      = ใช้ matrix ถ้ามี ไม่งั้นถอยไป geometric
POSE_METHOD=geometric
# วินาทีแรกที่ต้องนั่งมองตรง เพื่อให้ระบบจำท่านิ่งและ EAR ตาเปิดของแต่ละคน
# คนที่มีรูปใน faces/ ไม่ต้องรอรอบนี้ (ดูสามบรรทัดถัดไป) — ค่านี้ยังใช้กับ EAR อยู่
POSE_CALIBRATION_SECONDS=3.0
# อ่านท่านิ่งจากรูปลงทะเบียนใน faces/ แทนการนั่งมองตรงตอนเริ่ม
# รูปพวกนั้นเป็นภาพหน้าตรงอยู่แล้ว จึงเป็นจุดอ้างอิงที่ตรงกว่า "ท่าที่บังเอิญทำอยู่"
# ⚠️ ใช้ได้กับ POSE_METHOD=geometric เท่านั้น · วิธี matrix คิดเป็นองศา คนละหน่วยกัน
POSE_NEUTRAL_FROM_PHOTOS=true
# รูปที่ค่า yaw เกินเกณฑ์การหันหน้า × ค่านี้ = คนในรูปหันข้างอยู่จริง ไม่ใช่ bias ประจำตัว
POSE_PHOTO_NEUTRAL_MAX_RATIO=1.0
# แกน pitch ไม่มีศูนย์ให้เทียบ (จมูกอยู่ต่ำกว่าตาเป็นทุนเดิม) จึงเทียบกับมัธยฐานของ
# คนอื่นในแกลเลอรี — ต้องมีคนอย่างน้อยเท่านี้ ไม่ถึงก็ข้ามการตรวจแกนนั้นไป
POSE_PHOTO_NEUTRAL_MIN_PEOPLE=3
# เกณฑ์สำหรับ geometric (สัดส่วนเทียบขนาดใบหน้า ไม่ใช่องศา)
POSE_YAW_THRESHOLD=0.08
POSE_PITCH_THRESHOLD=0.06
# เกณฑ์สำหรับ matrix (องศา) — คนละหน่วยกับสองบรรทัดข้างบน
POSE_YAW_THRESHOLD_DEG=18
POSE_PITCH_THRESHOLD_DEG=14
# กลับเครื่องหมายถ้าดูบนจอแล้วทิศสลับข้าง
POSE_MATRIX_INVERT_YAW=false
POSE_MATRIX_INVERT_PITCH=false
# ต้องกลับมาต่ำกว่า threshold × ค่านี้ ถึงจะพร้อมนับครั้งถัดไป (กันนับซ้ำรัว ๆ)
POSE_RELEASE_RATIO=0.6
# ต้องหันค้างอย่างน้อยกี่วินาทีถึงนับเป็น 1 ครั้ง
POSE_HOLD_SECONDS=0.25
# ใช้มัธยฐานของกี่เฟรมเพื่อลด noise (มัธยฐานทนค่ากระโดดดีกว่าค่าเฉลี่ย)
POSE_SMOOTH_FRAMES=5

# ── การกะพริบตา / ความง่วง ───────────────────────────────
# ⚠️ ทั้งหมวดนี้ใช้เฉพาะโหมด person — โหมด room ไม่วัดตาเลย ค่าพวกนี้จึงไม่มีผล
# blendshape = คะแนนจากโมเดล — แม่นที่สุด ไม่ต้อง calibrate รายคน
# ear        = คำนวณเรขาคณิต + baseline รายคน
# auto       = ใช้ blendshape ถ้ามี ไม่งั้นถอยไป ear  (แนะนำ)
BLINK_METHOD=auto
# คะแนน 0–1 ที่ถือว่าตาปิด (ใช้กับทั้งสองวิธี)
BLINK_CLOSED_SCORE=0.5
# เกณฑ์สำรองเมื่อยังไม่ได้ calibrate — ตรงกับ WEBCAM.drowsyEarBelow ฝั่งเว็บ
BLINK_EAR_THRESHOLD=0.18
# เปอร์เซ็นไทล์ของ EAR ตอน calibrate ที่ถือว่าเป็น "ตาเปิด"
# ใช้ค่าสูงเพราะระหว่าง calibrate ผู้ใช้ย่อมกะพริบตาบ้าง
BLINK_EAR_OPEN_PERCENTILE=0.75
# threshold ของแต่ละคน = EAR ตาเปิดของคนนั้น × ค่านี้
BLINK_EAR_CLOSE_RATIO=0.65
BLINK_CONSECUTIVE_FRAMES=2
# หลับตานานเกินกี่วินาที = ง่วง (ไม่ใช่แค่กะพริบ)
BLINK_DROWSY_SECONDS=1.2
# ช่วงปกติ ตรงกับ WEBCAM.blinkNormal ฝั่งเว็บ — ใช้แค่แสดงผล
BLINK_NORMAL_RATE_MIN=8
BLINK_NORMAL_RATE_MAX=21

# ── คุณภาพของการวัด ──────────────────────────────────────
# ระยะระหว่างหางตาสองข้างเป็นพิกเซล — ต่ำกว่านี้ = ไม่วิเคราะห์ (แต่ยังนับใน face_count)
# เพราะระยะเปลือกตาที่ใช้คำนวณ EAR เล็กกว่านี้ราว 12 เท่า จะเหลือไม่กี่พิกเซล
QUALITY_MIN_INTEROCULAR_PX=40
# ถึงค่านี้ = ถือว่าคุณภาพเต็ม 100%
QUALITY_GOOD_INTEROCULAR_PX=90
# ใบหน้าที่ถูกซูมอ่านให้ landmark แม่นกว่าที่จำนวนพิกเซลในเฟรมบ่งบอก เพราะโมเดล
# ได้ทำงานที่ความละเอียดที่มันถูกฝึกมา · ค่านี้คือ**เพดานของเครดิต**นั้น
# ⚠️ เป็นค่าประมาณ ไม่ใช่ค่าที่วัดมา — การขยายภาพไม่ได้สร้างพิกเซลของเปลือกตาขึ้นมาจริง
#    ตั้งสูงเกินไปแล้วค่า EAR ของคนไกลจะเป็นสัญญาณรบกวนที่ดูน่าเชื่อ
#    ตั้ง 1.0 เพื่อปิดเครดิตนี้ (กลับไปนับเฉพาะพิกเซลในเฟรมตามเดิม)
#    นี่คือค่าแรกที่ควรปรับเมื่อเอาไปใช้กับกล้องและห้องจริง
QUALITY_ZOOM_CREDIT=2.0

# ── โหมดการทำงาน ─────────────────────────────────────────
# room   = วัดภาพรวมของห้อง — นับคน + การหันหน้า
#          ไม่แยกรายบุคคล · ไม่วัดตา (EAR/กะพริบ/ง่วง) · ไม่คำนวณลายเซ็นใบหน้าเลย
# person = ติดตามทีละคนด้วย id · วัดตาครบ · จำ id ได้เมื่อออกไปแล้วกลับมา
# known  = รู้จักเฉพาะคนที่มีรูปใน faces/ · คนที่ไม่มีรูปไม่ถูกบันทึกและไม่ถูกจำ
#          ต้องวางรูปก่อนถึงจะมีข้อมูลออกมา (ไม่มีรูป = ไม่มีแถวเลย ไม่ใช่แถวว่าง)
# เว้นว่าง = โปรแกรมถามให้เลือกตอนเปิด (ไม่มีหน้าจอถาม เช่นรันผ่าน cron จะใช้ room)
# ทับได้ตอนรันด้วย --mode room / --mode person / --mode known
VISION_MODE=

# ── การติดตามบุคคล ───────────────────────────────────────
# ⚠️ ค่าในหมวดนี้ใช้เฉพาะโหมด person — โหมด room บังคับปิด re-ID ให้เอง
# ระยะห่างสูงสุด (สัดส่วนความกว้างภาพ) ที่ยังถือว่าเป็นคนเดิม
TRACKER_MAX_DISTANCE=0.25
# ทำนายล่วงหน้าได้ไกลสุดกี่วินาที — ตัวคุมหลักของอาการ "คนขยับเยอะแล้ว id หลุด"
# วัดกับ 144 สถานการณ์การเคลื่อนไหว: ไม่จำกัด = รักษา id ได้ 37% · 0.10 = 47%
# ต่ำกว่า 0.05 การทำนายอ่อนจน id เริ่มสลับคนตอนสองคนเดินสวนกัน
TRACKER_PREDICT_HORIZON=0.10
# ขยายวงจับคู่ตามเวลาที่หายไป — ⚠️ ปิดไว้เพราะวัดแล้วว่าอันตราย ไม่ใช่ยังไม่ได้ลอง
# เปิดที่ 2.0/0.8: รักษา id ดีขึ้น 47%→72% แต่คนใหม่สวมรอย id คนเก่า 92% ของกรณี
# เปิดได้เฉพาะเมื่อมั่นใจว่ามีคนเดียวในเฟรมเสมอ
TRACKER_GATE_DRIFT=0.0
TRACKER_MAX_GATE=0.25
# หายไปกี่วินาทีถึงย้ายเข้ากลุ่มที่จำไว้ — ตั้งสูงขึ้นช่วยลด id ใหม่ตอนหน้าหลุดสั้น ๆ
TRACKER_FORGET_SECONDS=6.0
# น้ำหนักของแต่ละสัญญาณในการจับคู่ (รวมกันควรเป็น 1.0)
TRACKER_WEIGHT_DISTANCE=0.5
TRACKER_WEIGHT_IOU=0.35
TRACKER_WEIGHT_SIZE=0.15
# ทำนายตำแหน่งถัดไปจากความเร็ว — ช่วยมากเมื่อมีคนเดินผ่านกล้อง
TRACKER_USE_PREDICTION=true
TRACKER_VELOCITY_SMOOTHING=0.6
# ตรวจสลับคู่หลังจับคู่เสร็จ — กัน id สลับตอนสองคนเดินไขว้กัน
TRACKER_SWAP_GUARD=true

# ── re-identification: จำ id เมื่อคนออกจากเฟรมแล้วกลับมา ──
# ⚠️ เปิดแล้วระบบเก็บ "ลายเซ็นโครงหน้า" ไว้ใน RAM ซึ่งเป็นข้อมูลชีวมิติแบบอ่อน
#    ถ้าใช้ในพื้นที่ที่มีผู้อื่น ต้องแจ้งและขอความยินยอมก่อน — อ่านหัวข้อความเป็นส่วนตัวใน README
#    ถ้าไม่จำเป็นต้องจำ id ข้ามการเข้า-ออก ให้ตั้งเป็น false
TRACKER_REID_ENABLED=true
# จำลายเซ็นไว้กี่วินาทีหลังคนหายจากเฟรม (เกินนี้ = ลืมถาวร)
# 3600 = ทั้งคาบเรียน คนที่ออกไปเข้าห้องน้ำแล้วกลับมาจึงยังได้ id เดิม
TRACKER_REID_MEMORY_SECONDS=3600
# จำได้พร้อมกันกี่คน — เกินนี้ลืมคนที่หายไปนานที่สุดก่อน
# จำกัดด้วยจำนวนคนแทนเวลา ทำให้ตั้งเวลาไว้ยาว ๆ ได้โดย RAM ไม่บาน
TRACKER_REID_MAX_POOL=30
# ระยะห่างลายเซ็นสูงสุดที่ยังถือว่าเป็นคนเดิม (0.05 = ต่างกันเฉลี่ย 5%)
# ⚠️ ค่านี้มาจากใบหน้าสังเคราะห์ ต้องทดสอบกับคนจริงแล้วปรับเอง
# ต่ำเกินไป = ไม่เคยจำได้ · สูงเกินไป = จำสลับคน (อันตรายกว่ามาก)
TRACKER_REID_THRESHOLD=0.05
# ใบหน้าต้องใหญ่กว่านี้ (สัดส่วนของเฟรม) ถึงจะเอาไปเรียน/เทียบลายเซ็น
TRACKER_REID_MIN_SIZE=0.12
# เฉลี่ยลายเซ็นจากกี่ตัวอย่างก่อนหยุดปรับ
TRACKER_REID_MAX_SAMPLES=30
# ต้องสะสมกี่เฟรมก่อนถึงจะเชื่อลายเซ็นได้
# จากการวัด: ลายเซ็นจากเฟรมเดียวแยกคนไม่ออกเลย — อย่าลดต่ำกว่า 10
TRACKER_REID_MIN_SAMPLES=15
# ratio test — ตัวที่ใกล้ที่สุดต้องดีกว่าอันดับสองอย่างน้อยเท่านี้
# ตั้ง 1.0 = ปิด ratio test (ไม่แนะนำ — จะยอมเดาแม้แยกไม่ออก)
TRACKER_REID_RATIO=0.75

# ── ลดการแจก id ใหม่ ─────────────────────────────────────
# เหลือคนให้เทียบคนเดียว ผ่อนเกณฑ์ได้ เพราะไม่มีใครให้จำสลับ
TRACKER_REID_THRESHOLD_SINGLE=0.08
# ลองเทียบซ้ำได้กี่เฟรมก่อนยอมรับว่าเป็นคนใหม่จริง
# ลองครั้งเดียวแล้วเลิกทำให้พลาดตอนเฟรมแรก ๆ ลายเซ็นยังไม่นิ่ง
TRACKER_REID_MAX_ATTEMPTS=60
# ลายเซ็นถือว่านิ่งเมื่อค่าเปลี่ยนน้อยกว่านี้ติดกัน N เฟรม แล้วเทียบได้เลย
# ไม่ต้องรอครบ MIN_SAMPLES ถ้ามันนิ่งก่อน — ช่วยให้คืน id เดิมได้เร็วขึ้น
TRACKER_REID_STABLE_EPS=0.006
TRACKER_REID_STABLE_NEEDED=5

# ── หน้าต่างสรุปผล ───────────────────────────────────────
# 15 วินาที ตรงกับที่ตาราง focus ของโปรเจกต์ใช้อยู่ — อย่าเปลี่ยนถ้าจะต่อกับแดชบอร์ด
WINDOW_SECONDS=15
# ขยับเกินกี่ครั้ง/นาที = เสียสมาธิ (ตรงกับ FOCUS_THRESHOLD_DEFAULT ฝั่งเว็บ)
WINDOW_MOVEMENT_THRESHOLD=8
# เก็บจำนวนคนต่อเฟรมไว้กี่ค่าเพื่อหามัธยฐาน (ใช้เฉพาะโหมด room)
# 900 = 60 fps × 15 วินาที ซึ่งเผื่อไว้เกินพอ
WINDOW_OCCUPANCY_SAMPLES=900

# ── การแสดงผล ────────────────────────────────────────────
DISPLAY_ENABLED=true
DISPLAY_WINDOW_NAME=pi-vision — face detection
# วาด landmark ครบ 468 จุด (สวยแต่กิน CPU)
DISPLAY_DRAW_MESH=false
DISPLAY_DRAW_EYES=true
# แสดงรายละเอียดได้สูงสุดกี่คนบนแผง HUD (ที่เหลือสรุปเป็นบรรทัดเดียว)
DISPLAY_HUD_MAX_FACES=6
DISPLAY_LOG_TO_CONSOLE=true
# โชว์คะแนนอารมณ์ดิบทั้งสี่ค่า (กด e สลับได้ขณะรัน) — ใช้ตอนปรับ EMOTION_THRESHOLD
DISPLAY_EMOTION_SCORES=false

# ── ส่งข้อมูลขึ้น Supabase ────────────────────────────────
# ไม่ใส่สองบรรทัดแรก = ไม่ส่งอะไรเลย (โปรแกรมยังทำงานและแสดงผลบนจอครบ)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_FOCUS_TABLE=focus
# โหมดห้องรวมมี payload คนละแบบ ต้องมีตารางของตัวเอง · เว้นว่าง = โหมดนั้นไม่ส่ง
SUPABASE_ROOM_TABLE=
SUPABASE_TIMEOUT_SECONDS=10
# คิวเผื่อเน็ตหลุด — เกิน queue_max แล้วทิ้งแถวเก่าสุดก่อน
SUPABASE_QUEUE_PATH=queue.jsonl
SUPABASE_QUEUE_MAX=5000
SUPABASE_RETRY_BASE_SECONDS=1
SUPABASE_RETRY_MAX_SECONDS=60

# ── อารมณ์จากการแสดงออกบนใบหน้า ──────────────────────────
# อ่านจาก blendshapes ที่เปิดอยู่แล้ว (MODEL_BLENDSHAPES) จึงไม่มีโมเดลเพิ่ม
EMOTION_ENABLED=true
# ต่ำกว่านี้ทุกตัว = หน้านิ่ง (neutral)
EMOTION_THRESHOLD=0.35
# อันดับหนึ่งต้องชนะอันดับสองเท่านี้ ไม่งั้น neutral — กันค่าแกว่งระหว่างสองอารมณ์
EMOTION_MARGIN=0.08
EMOTION_WINDOW_FRAMES=12
EMOTION_HOLD_FRAMES=6

# ── จำคนจากรูปในโฟลเดอร์ ────────────────────────────────
# ⚠️ วางรูปแล้วข้อมูลจะผูกกับชื่อคนจริง และรูปอยู่บนดิสก์ — อ่านหัวข้อความเป็นส่วนตัว
#    ใน README ก่อน · โฟลเดอร์ว่าง = ใช้หมายเลขเหมือนเดิม
FACES_DIR=faces
# ต่ำ = เข้มขึ้น ยอมรับยากขึ้น (ติดชื่อผิดคนแย่กว่าไม่รู้ชื่อ)
# ⚠️ เมื่อ FACES_AUTO_THRESHOLD=true (ค่าเริ่มต้น) ค่านี้ถูกใช้เฉพาะตอนที่วัดจากรูปไม่ได้
FACES_THRESHOLD=0.045
FACES_RATIO=0.75

# ── ตั้งเกณฑ์เองจากชุดรูป ────────────────────────────────
# คำนวณ FACES_THRESHOLD จากรูปในโฟลเดอร์เอง ทุกครั้งที่อ่านรูป โดยวัดสองอย่าง:
# รูปคนเดียวกันห่างกันแค่ไหน (เกณฑ์ต้องอยู่เหนือค่านี้) และคู่คนที่ใกล้กันที่สุด
# ห่างกันแค่ไหน (เกณฑ์ต้องอยู่ใต้ค่านี้) แล้ววางเกณฑ์ไว้กลางช่องว่างนั้น
# ค่าที่ได้จะถูกพิมพ์ลง console ตอนเริ่มและทุกครั้งที่อ่านรูปใหม่ — ดูของจริงก่อนปรับ
FACES_AUTO_THRESHOLD=true
# เปอร์เซ็นไทล์ของระยะ "รูปคนเดียวกันห่างกัน" ที่ใช้เป็นพื้น (ไม่ใช้ค่าสูงสุด เพราะ
# รูปเบี้ยวใบเดียวจะดันเกณฑ์ขึ้นจนหลวมทั้งระบบ)
FACES_AUTO_INTRA_PERCENTILE=0.9
# ส่วนเผื่อเหนือพื้น สำหรับสิ่งที่รูปบอกไม่ได้ — กล้องสั่น แสงต่าง ระยะต่างจากตอนถ่ายรูป
# ต่ำ = เข้มขึ้น (คนจริงอาจไม่ผ่านเกณฑ์) · สูง = หลวมขึ้น (เสี่ยงติดชื่อผิดคน)
FACES_AUTO_SPREAD=1.5
# เพดาน = ระยะของคู่คนที่ใกล้กันที่สุด × ค่านี้ — ต่ำ = กันชนหนาขึ้น
FACES_AUTO_INTER_FRACTION=0.5
# ขอบเขตของค่าที่คำนวณได้ — กันชุดรูปผิดปกติลากเกณฑ์ไปสุดทาง
FACES_AUTO_MIN=0.01
FACES_AUTO_MAX=0.09
# true = เดาคนที่ใกล้ที่สุดเสมอ ไม่ขึ้นว่า unknown (ชื่อที่ยังไม่มั่นใจมี ? ต่อท้ายบนจอ)
# false = ไม่มั่นใจให้ใช้หมายเลขแทน — เลือกอันนี้ถ้าจะเอาข้อมูลไปใช้จริงจัง
#         เพราะการเดาย้ายความผิดพลาดจาก "ไม่มีชื่อ" ไปเป็น "ชื่อผิด" ที่มองไม่เห็น
FACES_GUESS=true
FACES_MIN_SIZE=0.12
# ตรวจโฟลเดอร์ซ้ำทุกกี่วินาที — วางรูปใหม่แล้วมีผลโดยไม่ต้องรีสตาร์ต · 0 = ครั้งเดียว
FACES_RESCAN_SECONDS=20

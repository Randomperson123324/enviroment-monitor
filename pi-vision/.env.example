# pi-vision — ค่าตั้งทั้งหมด
# คัดลอกเป็น .env แล้วแก้เฉพาะบรรทัดที่ต้องการ
# ทุกค่าเป็น optional — ค่า default อยู่ใน config.py และตรงกับที่เขียนไว้ตรงนี้

# ── กล้อง ────────────────────────────────────────────────
# csi = Camera Module 3 (Picamera2) · usb = USB webcam (OpenCV) · auto = ลอง csi ก่อน
CAMERA_SOURCE=auto
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
# index ของ USB webcam (0 = ตัวแรก) หรือใส่ path เช่น /dev/video0
CAMERA_USB_INDEX=0
# พลิกซ้าย-ขวาให้เหมือนส่องกระจก
# ⚠️ ค่านี้กำหนดว่าป้าย Left/Right หมายถึงด้านไหน — ถ้าเปลี่ยนต้องดูผลบนจอซ้ำ
CAMERA_MIRROR=true
# หมุนภาพ 0 / 90 / 180 / 270 เผื่อติดกล้องตะแคง
CAMERA_ROTATE=0

# ── โมเดล MediaPipe ──────────────────────────────────────
# ไฟล์จะถูกดาวน์โหลดอัตโนมัติครั้งแรกถ้ายังไม่มี
MODEL_PATH=models/face_landmarker.task
# MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
MODEL_AUTO_DOWNLOAD=true
# จำนวนใบหน้าสูงสุดที่วิเคราะห์พร้อมกัน — ดูตาราง CPU ใน README ก่อนเพิ่ม
MODEL_MAX_FACES=6
MODEL_MIN_DETECTION_CONFIDENCE=0.5
MODEL_MIN_PRESENCE_CONFIDENCE=0.5
MODEL_MIN_TRACKING_CONFIDENCE=0.5
# blendshapes ให้คะแนนการหลับตาที่แม่นกว่า EAR มาก — ควรเปิดไว้
MODEL_BLENDSHAPES=true
# transformation matrix ให้มุมหันหน้าเป็นองศาจริง — เปิดเมื่อใช้ POSE_METHOD=matrix
MODEL_TRANSFORM_MATRIX=false

# ── การหันหน้า ───────────────────────────────────────────
# geometric = ประมาณจากตำแหน่งจมูก (ค่าเริ่มต้น ผ่านการทดสอบแล้ว)
# matrix    = จาก transformation matrix ได้องศาจริง แม่นกว่าเมื่อหันมาก
#             ต้องเปิด MODEL_TRANSFORM_MATRIX และยืนยันทิศบนจอก่อน
# auto      = ใช้ matrix ถ้ามี ไม่งั้นถอยไป geometric
POSE_METHOD=geometric
# วินาทีแรกที่ต้องนั่งมองตรง เพื่อให้ระบบจำท่านิ่งและ EAR ตาเปิดของแต่ละคน
POSE_CALIBRATION_SECONDS=3.0
# เกณฑ์สำหรับ geometric (สัดส่วนเทียบขนาดใบหน้า ไม่ใช่องศา)
POSE_YAW_THRESHOLD=0.08
POSE_PITCH_THRESHOLD=0.06
# เกณฑ์สำหรับ matrix (องศา) — คนละหน่วยกับสองบรรทัดข้างบน
POSE_YAW_THRESHOLD_DEG=18
POSE_PITCH_THRESHOLD_DEG=14
# กลับเครื่องหมายถ้าดูบนจอแล้วทิศสลับข้าง
POSE_MATRIX_INVERT_YAW=false
POSE_MATRIX_INVERT_PITCH=false
# ต้องกลับมาต่ำกว่า threshold × ค่านี้ ถึงจะพร้อมนับครั้งถัดไป (กันนับซ้ำรัว ๆ)
POSE_RELEASE_RATIO=0.6
# ต้องหันค้างอย่างน้อยกี่วินาทีถึงนับเป็น 1 ครั้ง
POSE_HOLD_SECONDS=0.25
# ใช้มัธยฐานของกี่เฟรมเพื่อลด noise (มัธยฐานทนค่ากระโดดดีกว่าค่าเฉลี่ย)
POSE_SMOOTH_FRAMES=5

# ── การกะพริบตา / ความง่วง ───────────────────────────────
# ⚠️ ทั้งหมวดนี้ใช้เฉพาะโหมด person — โหมด room ไม่วัดตาเลย ค่าพวกนี้จึงไม่มีผล
# blendshape = คะแนนจากโมเดล — แม่นที่สุด ไม่ต้อง calibrate รายคน
# ear        = คำนวณเรขาคณิต + baseline รายคน
# auto       = ใช้ blendshape ถ้ามี ไม่งั้นถอยไป ear  (แนะนำ)
BLINK_METHOD=auto
# คะแนน 0–1 ที่ถือว่าตาปิด (ใช้กับทั้งสองวิธี)
BLINK_CLOSED_SCORE=0.5
# เกณฑ์สำรองเมื่อยังไม่ได้ calibrate — ตรงกับ WEBCAM.drowsyEarBelow ฝั่งเว็บ
BLINK_EAR_THRESHOLD=0.18
# เปอร์เซ็นไทล์ของ EAR ตอน calibrate ที่ถือว่าเป็น "ตาเปิด"
# ใช้ค่าสูงเพราะระหว่าง calibrate ผู้ใช้ย่อมกะพริบตาบ้าง
BLINK_EAR_OPEN_PERCENTILE=0.75
# threshold ของแต่ละคน = EAR ตาเปิดของคนนั้น × ค่านี้
BLINK_EAR_CLOSE_RATIO=0.65
BLINK_CONSECUTIVE_FRAMES=2
# หลับตานานเกินกี่วินาที = ง่วง (ไม่ใช่แค่กะพริบ)
BLINK_DROWSY_SECONDS=1.2
# ช่วงปกติ ตรงกับ WEBCAM.blinkNormal ฝั่งเว็บ — ใช้แค่แสดงผล
BLINK_NORMAL_RATE_MIN=8
BLINK_NORMAL_RATE_MAX=21

# ── คุณภาพของการวัด ──────────────────────────────────────
# ระยะระหว่างหางตาสองข้างเป็นพิกเซล — ต่ำกว่านี้ = ไม่วิเคราะห์ (แต่ยังนับใน face_count)
# เพราะระยะเปลือกตาที่ใช้คำนวณ EAR เล็กกว่านี้ราว 12 เท่า จะเหลือไม่กี่พิกเซล
QUALITY_MIN_INTEROCULAR_PX=40
# ถึงค่านี้ = ถือว่าคุณภาพเต็ม 100%
QUALITY_GOOD_INTEROCULAR_PX=90

# ── โหมดการทำงาน ─────────────────────────────────────────
# room   = วัดภาพรวมของห้อง — นับคน + การหันหน้า
#          ไม่แยกรายบุคคล · ไม่วัดตา (EAR/กะพริบ/ง่วง) · ไม่คำนวณลายเซ็นใบหน้าเลย
# person = ติดตามทีละคนด้วย id · วัดตาครบ · จำ id ได้เมื่อออกไปแล้วกลับมา
# เว้นว่าง = โปรแกรมถามให้เลือกตอนเปิด (ไม่มีหน้าจอถาม เช่นรันผ่าน cron จะใช้ room)
# ทับได้ตอนรันด้วย --mode room / --mode person
VISION_MODE=

# ── การติดตามบุคคล ───────────────────────────────────────
# ⚠️ ค่าในหมวดนี้ใช้เฉพาะโหมด person — โหมด room บังคับปิด re-ID ให้เอง
# ระยะห่างสูงสุด (สัดส่วนความกว้างภาพ) ที่ยังถือว่าเป็นคนเดิม
TRACKER_MAX_DISTANCE=0.25
# หายไปกี่วินาทีถึงย้ายเข้ากลุ่มที่จำไว้ — ตั้งสูงขึ้นช่วยลด id ใหม่ตอนหน้าหลุดสั้น ๆ
TRACKER_FORGET_SECONDS=6.0
# น้ำหนักของแต่ละสัญญาณในการจับคู่ (รวมกันควรเป็น 1.0)
TRACKER_WEIGHT_DISTANCE=0.5
TRACKER_WEIGHT_IOU=0.35
TRACKER_WEIGHT_SIZE=0.15
# ทำนายตำแหน่งถัดไปจากความเร็ว — ช่วยมากเมื่อมีคนเดินผ่านกล้อง
TRACKER_USE_PREDICTION=true
TRACKER_VELOCITY_SMOOTHING=0.6
# ตรวจสลับคู่หลังจับคู่เสร็จ — กัน id สลับตอนสองคนเดินไขว้กัน
TRACKER_SWAP_GUARD=true

# ── re-identification: จำ id เมื่อคนออกจากเฟรมแล้วกลับมา ──
# ⚠️ เปิดแล้วระบบเก็บ "ลายเซ็นโครงหน้า" ไว้ใน RAM ซึ่งเป็นข้อมูลชีวมิติแบบอ่อน
#    ถ้าใช้ในพื้นที่ที่มีผู้อื่น ต้องแจ้งและขอความยินยอมก่อน — อ่านหัวข้อความเป็นส่วนตัวใน README
#    ถ้าไม่จำเป็นต้องจำ id ข้ามการเข้า-ออก ให้ตั้งเป็น false
TRACKER_REID_ENABLED=true
# จำลายเซ็นไว้กี่วินาทีหลังคนหายจากเฟรม (เกินนี้ = ลืมถาวร)
# 3600 = ทั้งคาบเรียน คนที่ออกไปเข้าห้องน้ำแล้วกลับมาจึงยังได้ id เดิม
TRACKER_REID_MEMORY_SECONDS=3600
# จำได้พร้อมกันกี่คน — เกินนี้ลืมคนที่หายไปนานที่สุดก่อน
# จำกัดด้วยจำนวนคนแทนเวลา ทำให้ตั้งเวลาไว้ยาว ๆ ได้โดย RAM ไม่บาน
TRACKER_REID_MAX_POOL=30
# ระยะห่างลายเซ็นสูงสุดที่ยังถือว่าเป็นคนเดิม (0.05 = ต่างกันเฉลี่ย 5%)
# ⚠️ ค่านี้มาจากใบหน้าสังเคราะห์ ต้องทดสอบกับคนจริงแล้วปรับเอง
# ต่ำเกินไป = ไม่เคยจำได้ · สูงเกินไป = จำสลับคน (อันตรายกว่ามาก)
TRACKER_REID_THRESHOLD=0.05
# ใบหน้าต้องใหญ่กว่านี้ (สัดส่วนของเฟรม) ถึงจะเอาไปเรียน/เทียบลายเซ็น
TRACKER_REID_MIN_SIZE=0.12
# เฉลี่ยลายเซ็นจากกี่ตัวอย่างก่อนหยุดปรับ
TRACKER_REID_MAX_SAMPLES=30
# ต้องสะสมกี่เฟรมก่อนถึงจะเชื่อลายเซ็นได้
# จากการวัด: ลายเซ็นจากเฟรมเดียวแยกคนไม่ออกเลย — อย่าลดต่ำกว่า 10
TRACKER_REID_MIN_SAMPLES=15
# ratio test — ตัวที่ใกล้ที่สุดต้องดีกว่าอันดับสองอย่างน้อยเท่านี้
# ตั้ง 1.0 = ปิด ratio test (ไม่แนะนำ — จะยอมเดาแม้แยกไม่ออก)
TRACKER_REID_RATIO=0.75

# ── ลดการแจก id ใหม่ ─────────────────────────────────────
# เหลือคนให้เทียบคนเดียว ผ่อนเกณฑ์ได้ เพราะไม่มีใครให้จำสลับ
TRACKER_REID_THRESHOLD_SINGLE=0.08
# ลองเทียบซ้ำได้กี่เฟรมก่อนยอมรับว่าเป็นคนใหม่จริง
# ลองครั้งเดียวแล้วเลิกทำให้พลาดตอนเฟรมแรก ๆ ลายเซ็นยังไม่นิ่ง
TRACKER_REID_MAX_ATTEMPTS=60
# ลายเซ็นถือว่านิ่งเมื่อค่าเปลี่ยนน้อยกว่านี้ติดกัน N เฟรม แล้วเทียบได้เลย
# ไม่ต้องรอครบ MIN_SAMPLES ถ้ามันนิ่งก่อน — ช่วยให้คืน id เดิมได้เร็วขึ้น
TRACKER_REID_STABLE_EPS=0.006
TRACKER_REID_STABLE_NEEDED=5

# ── หน้าต่างสรุปผล ───────────────────────────────────────
# 15 วินาที ตรงกับที่ตาราง focus ของโปรเจกต์ใช้อยู่ — อย่าเปลี่ยนถ้าจะต่อกับแดชบอร์ด
WINDOW_SECONDS=15
# ขยับเกินกี่ครั้ง/นาที = เสียสมาธิ (ตรงกับ FOCUS_THRESHOLD_DEFAULT ฝั่งเว็บ)
WINDOW_MOVEMENT_THRESHOLD=8
# เก็บจำนวนคนต่อเฟรมไว้กี่ค่าเพื่อหามัธยฐาน (ใช้เฉพาะโหมด room)
# 900 = 60 fps × 15 วินาที ซึ่งเผื่อไว้เกินพอ
WINDOW_OCCUPANCY_SAMPLES=900

# ── การแสดงผล ────────────────────────────────────────────
DISPLAY_ENABLED=true
DISPLAY_WINDOW_NAME=pi-vision — face detection
# วาด landmark ครบ 468 จุด (สวยแต่กิน CPU)
DISPLAY_DRAW_MESH=false
DISPLAY_DRAW_EYES=true
# แสดงรายละเอียดได้สูงสุดกี่คนบนแผง HUD (ที่เหลือสรุปเป็นบรรทัดเดียว)
DISPLAY_HUD_MAX_FACES=6
DISPLAY_LOG_TO_CONSOLE=true
